# PostgreSQL 비동기 연결과 SQL 디버깅 설정
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/character_chat
DATABASE_ECHO=false

# 매 LLM 요청에 포함할 최근 user/assistant 메시지 개수
CHAT_HISTORY_LIMIT=20
CHAT_MEMORY_LIMIT=10
AUTO_MEMORY_ENABLED=false
AUTO_MEMORY_MAX_ITEMS=3
# 로컬 기본값은 비용 없는 hashing이다. 실제 의미 검색은 openai로 변경한다.
EMBEDDING_PROVIDER=hashing
# 아래 두 값은 현재 DB의 VECTOR(1536) 컬럼과 반드시 같아야 한다.
EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# OpenAI provider 설정
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.4-mini
LLM_SYSTEM_PROMPT=You are a helpful AI chat assistant. Answer naturally and in the same language as the user.
LLM_MAX_OUTPUT_TOKENS=1000

# 애플리케이션 로그 상세도
LOG_LEVEL=INFO
LOG_JSON=true

# 개발용 프론트엔드 origin 목록. 여러 개는 콤마로 구분한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 단일 프로세스 인메모리 rate limit
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
REDIS_URL=redis://localhost:6379/0

# JWT 서명 설정. 운영 환경에서는 반드시 충분히 긴 무작위 값으로 교체한다.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
