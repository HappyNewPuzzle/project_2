# PostgreSQL 비동기 연결과 SQL 디버깅 설정
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/character_chat
DATABASE_ECHO=false

# 매 LLM 요청에 포함할 최근 user/assistant 메시지 개수
CHAT_HISTORY_LIMIT=20

# OpenAI provider 설정
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.4-mini
LLM_SYSTEM_PROMPT=You are a helpful AI chat assistant. Answer naturally and in the same language as the user.
LLM_MAX_OUTPUT_TOKENS=1000

# 애플리케이션 로그 상세도
LOG_LEVEL=INFO
